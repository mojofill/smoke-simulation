#version 450

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
// ping
layout (binding = 0, rgba8) uniform readonly image2D smokeMapInput;
layout (binding = 1, r32f)  uniform readonly image2D horizontalVelocitiesInput;
layout (binding = 2, r32f)  uniform readonly image2D verticalVelocitiesInput;
layout (binding = 3, r32f)  uniform readonly image2D pressureMapInput;
layout (binding = 4, r8ui)  uniform readonly uimage2D solidMapInput; // technically dont need ping pong for solid map, since unchanging

// pong
layout (binding = 5, rgba8) uniform writeonly image2D smokeMapOutput;
layout (binding = 6, r32f)  uniform writeonly image2D horizontalVelocitiesOutput;
layout (binding = 7, r32f)  uniform writeonly image2D verticalVelocitiesOutput;
layout (binding = 8, r32f)  uniform writeonly image2D pressureMapOutput;
layout (binding = 9, r8ui)  uniform writeonly uimage2D solidMapOutput;

// ubo
layout (binding = 10) uniform UniformBufferObject {
    int width;
    int height;
    float density;
    float dt;
    float weightSOR;
};

layout(push_constant) uniform PushBlock {
    int ping;
};

float calculateVelocityDivergenceAtCell(ivec2 cellPos) {
    float velocityTop    = imageLoad(verticalVelocitiesInput,   cellPos + ivec2(0, 1)).x;
    float velocityLeft   = imageLoad(horizontalVelocitiesInput, cellPos + ivec2(0, 0)).x;
    float velocityRight  = imageLoad(horizontalVelocitiesInput, cellPos + ivec2(1, 0)).x;
    float velocityBottom = imageLoad(verticalVelocitiesInput,   cellPos + ivec2(0, 0)).x;

    float gradientX = velocityRight - velocityLeft;
    float gradientY = velocityTop - velocityBottom;

    float divergence = gradientX + gradientY;
    return divergence;
}

bool isSolid(ivec2 pos) {
    int x = pos.x;
    int y = pos.y;
    return (x < 0 || x >= width || y < 0 || y >= height) ? true : imageLoad(solidMapInput, pos).x == 1;
}

bool isSolid(int x, int y) {
    return (x < 0 || x >= width || y < 0 || y >= height) ? true : imageLoad(solidMapInput, ivec2(x, y)).x == 1;
}

float getPressure(ivec2 cellPos) {
    int x = cellPos.x;
    int y = cellPos.y;
    return (x < 0 || x >= width || y < 0 || y >= height) ? 0.0f : imageLoad(pressureMapInput, cellPos).x;
}

float getPressure(int x, int y) {
    return (x < 0 || x >= width || y < 0 || y >= height) ? 0.0f : imageLoad(pressureMapInput, ivec2(x, y)).x;
}

float pressureSolveCell(ivec2 cellPos) {
    int flowTop    = isSolid(cellPos + ivec2( 0,  1)) ? 0 : 1;
    int flowLeft   = isSolid(cellPos + ivec2(-1,  0)) ? 0 : 1;
    int flowRight  = isSolid(cellPos + ivec2( 1,  0)) ? 0 : 1;
    int flowBottom = isSolid(cellPos + ivec2( 0, -1)) ? 0 : 1;

    int fluidEdgeCount = flowLeft + flowRight + flowTop + flowBottom;

    if (isSolid(cellPos) || fluidEdgeCount == 0) {
        return 0; // not pressure outside of map or cell is solid
    }

    float pressureTop    = getPressure(cellPos + ivec2( 0,  1));
    float pressureLeft   = getPressure(cellPos + ivec2(-1,  0));
    float pressureRight  = getPressure(cellPos + ivec2( 1,  0));
    float pressureBottom = getPressure(cellPos + ivec2( 0, -1));

    float velocityTop    = imageLoad(verticalVelocitiesInput,   cellPos + ivec2(0, 1)).x;
    float velocityLeft   = imageLoad(horizontalVelocitiesInput, cellPos + ivec2(0, 0)).x;
    float velocityRight  = imageLoad(horizontalVelocitiesInput, cellPos + ivec2(1, 0)).x;
    float velocityBottom = imageLoad(verticalVelocitiesInput,   cellPos + ivec2(0, 0)).x;

    float pressureSum = flowRight * pressureRight + flowLeft * pressureLeft + flowTop * pressureTop + flowBottom * pressureBottom;

    float divergence = velocityRight - velocityLeft + velocityTop - velocityBottom;

    return float((pressureSum - density * divergence / dt) / float(fluidEdgeCount));
}

// gauss seidel red black checkerboard pattern
void solvePressure() {
    // if ping = 0, then only do even/even coords
    // if ping = 1, then only do odd/odd coords
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    float pressureOld = imageLoad(pressureMapInput, coord).x;

    if ((coord.x + coord.y) % 2 == ping) {
        float pressureNew = pressureSolveCell(coord);
        pressureOld = pressureOld + (pressureNew - pressureOld) * weightSOR;
    }

    imageStore(pressureMapOutput, coord, vec4(pressureOld));
}

void main() {
    // pass everything over
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);

    // do go beyond extra threads
    if (pos.x >= width || pos.y >= height) return;

    imageStore(smokeMapOutput, pos, imageLoad(smokeMapInput, pos));
    imageStore(horizontalVelocitiesOutput, pos, imageLoad(horizontalVelocitiesInput, pos));
    imageStore(verticalVelocitiesOutput, pos, imageLoad(verticalVelocitiesInput, pos));
    imageStore(solidMapOutput, pos, imageLoad(solidMapInput, pos));

    // also load in the +1
    if (pos.x == 799) {
        imageStore(horizontalVelocitiesOutput, pos + ivec2(1, 0), imageLoad(horizontalVelocitiesInput, pos + ivec2(1, 0)));
    }
    if (pos.y == 799) {
        imageStore(verticalVelocitiesOutput, pos + ivec2(0, 1), imageLoad(verticalVelocitiesInput, pos + ivec2(0, 1)));
    }

    imageStore(pressureMapOutput, pos, imageLoad(pressureMapInput, pos));
    solvePressure();
}